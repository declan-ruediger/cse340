<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cause:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header>
        <a class="brand" href="/">CSE 340 Service Network</a>
        <nav aria-label="Main navigation">
            <ul>
                <% navLinks.forEach((link) => { %>
                    <li><a href="<%= link.href %>" class="<%= activePage === link.href ? 'active' : '' %>"><%= link.label %></a></li>
                <% }); %>
            </ul>
        </nav>
    </header>